# Copy to server/.env and fill in. Never commit the real .env.

# memory = in-process store (no server needed)
# http://localhost:8080/fhir = the HAPI server from docker compose
# https://hapi.fhir.org/baseR4 = HAPI's public test server (shared and public: synthetic data only)
FHIR_BASE_URL=memory

# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the offline rules extractor
EXTRACTOR=auto
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
ANTHROPIC_API_KEY=

CORS_ORIGINS=*
